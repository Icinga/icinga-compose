# Settings for Icinga Compose. Copy this file to `.env` and adjust it there:
#
#   cp .env.example .env
#
# Sorted from "must care" to "probably never". Unless noted otherwise, each
# commented-out line shows the default you get if you leave it alone.

### Basics ###################################################################

# Which database to start: `mysql` (MariaDB) or `pgsql` (PostgreSQL).
# This line is required. Without it, neither a database nor Icinga Web starts.
COMPOSE_PROFILES=mysql

# Hostname of the Icinga 2 master. SET THIS BEFORE THE FIRST START, if at all:
# Icinga 2 issues its certificate for this name once, and changing it later
# requires `docker compose down -v`.
#ICINGA_HOSTNAME=icinga2

### PostgreSQL ###############################################################

# Using PostgreSQL? Set COMPOSE_PROFILES=pgsql above AND uncomment this.
# (The default is `mysql`.)
#DATABASE_TYPE=pgsql

### Passwords ################################################################

# The API, database and Redis passwords must not begin or end with whitespace.
# Icinga Web's generated configuration strips it, so its logins would fail.

# Icinga Web login for user `icingaadmin`.
#ICINGAWEB_ADMIN_PASSWORD=icinga

# Icinga 2 API password for user `root`.
#ICINGA_ADMIN_PASSWORD=icinga

# Database passwords, one per service. They only take effect on the very first
# start; changing them later requires `docker compose down -v`.
#DIRECTOR_DATABASE_PASSWORD=director
#ICINGADB_DATABASE_PASSWORD=icingadb
#ICINGAWEB_DATABASE_PASSWORD=icingaweb
#X509_DATABASE_PASSWORD=x509

# Redis password, shared by Icinga 2, Icinga DB and Icinga DB Web.
#ICINGADB_REDIS_PASSWORD=icingadb-redis

### Image versions ###########################################################

# Pin these for a reproducible setup, e.g. ICINGA_TAG=2.16.4.
#ICINGA_TAG=latest
# Icinga Web requires image version 2.14.1 or newer.
#ICINGAWEB_TAG=latest
#ICINGADB_TAG=latest
#MARIADB_TAG=latest
#POSTGRES_TAG=18-alpine
#GRAPHITE_TAG=latest
#REDIS_ICINGADB_TAG=alpine

### Advanced #################################################################

# Comma-separated Icinga Web modules to enable in addition to the bundled ones.
#ICINGAWEB_ENABLEDMODULES=

# Only the variables above reach the containers. Anything else, e.g. an
# image's own variable like GRAPHITE_TIME_ZONE, goes into compose.override.yml
# (see "Going Further" in README.md).
